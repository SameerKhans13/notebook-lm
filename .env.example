# Google Gemini API Key (Required)
GOOGLE_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Connection (Required)
# Local: postgresql://notebook_user:notebook_password@localhost:5432/notebook_db
# Cloud SQL: postgresql://postgres:YOUR_PASSWORD@YOUR_CLOUD_SQL_IP:5432/postgres
DATABASE_URL=postgresql://notebook_user:notebook_password@localhost:5432/notebook_db

# Application URL (Required)
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:3000
